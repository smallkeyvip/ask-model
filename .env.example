# === 阿里百炼知识库配置 ===
BAILIAN_API_URL=https://your-bailian-endpoint.example/api/v2/apps/knowledge/chat
BAILIAN_API_KEY=
BAILIAN_AGENT_ID=

# === DeepSeek LLM 配置 ===
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# === Chroma 本地向量库 ===
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=enterprise_knowledge

# === Embedding 模型 ===
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
EMBEDDING_LOCAL_FILES_ONLY=false

# === 记忆配置 ===
SHORT_TERM_WINDOW_SIZE=6
MID_TERM_SUMMARY_THRESHOLD=10
MID_TERM_MAX_SUMMARY_TOKENS=500
LONG_TERM_TOP_K=5
SESSION_TTL_SECONDS=3600

# === 检索配置 ===
RETRIEVE_TOP_K=10
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=3000

# === 输入预处理 ===
ENABLE_INPUT_PREPROCESS=true
SENSITIVE_KEYWORDS_EXTRA_FILE=./sensitive_words_extra.json
BUSINESS_DOMAIN_KEYWORDS=

# === 邀请制认证 ===
AUTH_DB_PATH=./data/auth.db
AUTH_COOKIE_NAME=ask_model_session
AUTH_SESSION_TTL_SECONDS=604800
INVITATION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# === API 安全边界 ===
ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
MAX_ACTIVE_CHAT_SESSIONS=20
MAX_UPLOAD_DOCUMENTS=20
MAX_UPLOAD_CHARS_PER_DOCUMENT=100000
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150

# === 服务配置 ===
HOST=0.0.0.0
PORT=8010
